<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="1dp"
        android:layout_marginTop="1dp"
        android:layout_marginEnd="1dp"
        android:layout_marginBottom="1dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="91dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:textAlignment="center">

            <TextView
                android:id="@+id/textView"
                android:layout_width="331dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/almendra_sc"
                android:text="@string/titulo"
                android:textAlignment="center"
                android:textColor="#813030"
                android:textSize="60sp" />

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                app:srcCompat="@drawable/logo" />
        </LinearLayout>

        <View
            android:id="@+id/view"
            android:layout_width="match_parent"
            android:layout_height="140dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            android:orientation="vertical">

            <Button
                android:id="@+id/botao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:height="65dp"
                android:backgroundTint="#813030"
                android:fontFamily="@font/amethysta"
                android:text="@string/folha_de_pagamento"
                android:textSize="20sp" />

            <Button
                android:id="@+id/botao2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:height="65dp"
                android:backgroundTint="#813030"
                android:textSize="20sp"
                android:fontFamily="@font/amethysta"
                android:text="@string/imposto_de_renda" />

            <Button
                android:id="@+id/botao3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:height="65dp"
                android:textSize="20sp"
                android:backgroundTint="#813030"
                android:fontFamily="@font/amethysta"
                android:text="@string/rescis_o" />

            <Button
                android:id="@+id/botao4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:height="65dp"
                android:textSize="20sp"
                android:backgroundTint="#813030"
                android:fontFamily="@font/amethysta"
                android:text="@string/fgts" />

            <View
                android:id="@+id/view2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/textView2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/almendra_sc"
                android:text="@string/desenvolvido_por_diego_e_henrique"
                android:textAlignment="center"
                android:textColor="#A60F0F"
                android:textColorHint="#A42A2A"
                android:textColorLink="#B83030"
                android:textSize="20sp" />
        </LinearLayout>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>